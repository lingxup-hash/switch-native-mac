+static uint64_t guest_start;
+static int owned(uint64_t a,size_t n){return a>=guest_start&&n<=16384&&a-guest_start<=16384-n;}
+int main(void){
+ size_t n=16384;void *p=mmap(NULL,n,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANON,-1,0);assert(p!=MAP_FAILED);
+ uint64_t a=(uint64_t)p;LCScope scope={0,0,0,owned};guest_start=a;uint32_t v=42,out=0;
+ assert(!lc_mach_write(NULL,a,&v,4)); /* no guest ownership => reject, even RW */
+ assert(lc_mach_write(&scope,a,&v,4));assert(scope.writes==1);assert(lc_mach_read(&scope,a,&out,4)&&out==42);
+ assert(mprotect(p,n,PROT_READ)==0);v=99;assert(!lc_mach_write(&scope,a,&v,4));assert(lc_mach_read(&scope,a,&out,4)&&out==42);
+ void *other=mmap(NULL,n,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANON,-1,0);assert(other!=MAP_FAILED);assert(!lc_mach_write(&scope,(uint64_t)other,&v,4));assert(!lc_mach_read(&scope,(uint64_t)other,&out,4));assert(munmap(other,n)==0);
