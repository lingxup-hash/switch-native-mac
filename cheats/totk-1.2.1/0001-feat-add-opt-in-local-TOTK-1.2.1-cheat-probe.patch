 }
 /* Scoped stack moves: independent host backing, copy back on unmap.
@@ -217,6 +226,20 @@ static uint64_t alias_map(int unmap,uint64_t addr,uint64_t size){
  }
  pthread_mutex_unlock(&memory_lock);return 0;
 }
+#if defined(TOTK_GAME_V121)
+/* Only the game's reserved heap and explicitly committed alias pages qualify.
+ * The caller also checks current Mach protections before every access. */
+int runtime_local_cheat_owned(uint64_t a,size_t n){
+ if(!n||a>UINT64_MAX-n)return 0;
+ uint64_t h=atomic_load(&lc_heap_start),b=atomic_load(&lc_alias_start),sz=atomic_load(&lc_alias_size);
+ if(h&&a>=h&&n<=HEAP_CAP&&a-h<=HEAP_CAP-n)return 1;
+ if(!b||a<b||n>sz||a-b>sz-n)return 0;
+ unsigned first=(unsigned)((a-b)/4096),last=(unsigned)((a-b+n-1)/4096);int ok=1;
+ pthread_mutex_lock(&memory_lock);
+ for(unsigned i=first;i<=last;i++)if(!alias_pages[i]){ok=0;break;}
+ pthread_mutex_unlock(&memory_lock);return ok;
+}
+#endif
 uint64_t runtime_heap_base(void){return (uintptr_t)heap;}
 /* Guest memory the game has committed (heap size + mapped alias pages), for memory reports (iOS app monitor). */
 void runtime_guest_committed(uint64_t *heap_bytes,uint64_t *alias_mapped){*heap_bytes=heap_size;*alias_mapped=alias_bytes;}
diff --git a/tests/local_cheats121_config_probe.c b/tests/local_cheats121_config_probe.c
new file mode 100644
index 0000000..c6e5496
--- /dev/null
+++ b/tests/local_cheats121_config_probe.c
@@ -0,0 +1,15 @@
+#include <assert.h>
+#include "../games/totk/runtime/local_cheats121_config.h"
+static LCConfig parse(const char *s){FILE *f=tmpfile();assert(f);fputs(s,f);rewind(f);LCConfig c=lc_config(f);fclose(f);return c;}
+int main(void){
+ const char *digest="b7a2cc7e3465c4f11cd23f34cb38e037cf51d1d18310206f03b86c160ff2dbd0";
+ assert(lc_identity("1.2.1",digest));assert(!lc_identity("1.0.0",digest));assert(!lc_identity("1.2.1","other"));
+ LCConfig c=parse("enabled=1\nhealth=1\nstamina=1\nweapon=1\nrupees=1\nmaterials=1\ndry_run=1\n");assert(c.valid&&c.flags==31&&c.dry);
+ c=parse("# comment\n enabled = 0\nhealth=1\n");assert(c.valid&&!c.flags&&c.dry);
+ c=parse("enabled=1\nhealth=1\ndry_run=0\n");assert(c.flags==1&&!c.dry);
+ c=parse("enabled=1\nhealth=1\nunknown=1\n");assert(!c.valid&&!c.flags);
+ c=parse("enabled=1\nhealth=1\nhealth=0\n");assert(!c.valid&&!c.flags);
+ c=parse("enabled=1\nhealth=1trailing\n");assert(!c.valid&&!c.flags);
