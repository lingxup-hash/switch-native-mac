diff --git a/games/totk/runtime/local_cheats121.h b/games/totk/runtime/local_cheats121.h
new file mode 100644
index 0000000..d4419a2
--- /dev/null
+++ b/games/totk/runtime/local_cheats121.h
@@ -0,0 +1,75 @@
+#ifndef LOCAL_CHEATS121_H
+#define LOCAL_CHEATS121_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+typedef int (*LCRead)(void *, uint64_t, void *, size_t);
+typedef int (*LCWrite)(void *, uint64_t, const void *, size_t);
+typedef struct { void *ctx; LCRead read; LCWrite write; } LCMemory;
+typedef struct { unsigned writes[5]; unsigned ready; } LCStats;
+/* Local translation of selected Eiffel2018 1.2.1 codes supplied by the user.
+ * This is not an Atmosphere interpreter. Failed reads abort the affected operation. */
+static inline int lc_read(LCMemory m,uint64_t a,void *v,size_t n) {
+ return a>=0x1000 && n<=0x8000000000ULL && a<=0x8000000000ULL-n && m.read(m.ctx,a,v,n);
+}
+static inline uint64_t lc_ptr(LCMemory m,uint64_t p,uint64_t off) {
+ uint64_t v=0;if(!p||p>UINT64_MAX-off||!lc_read(m,p+off,&v,8)||v<0x1000||v>=0x8000000000ULL||(v&7))return 0;return v;
+}
+static inline uint64_t lc_chain(LCMemory m,uint64_t base,const uint32_t *offsets,size_t n) {
+ for(size_t i=0;i<n&&base;i++)base=lc_ptr(m,base,offsets[i]);return base;
+}
+static inline int lc_put(LCMemory m,uint64_t a,uint32_t v,int dry) {
+ uint32_t before=0;if(!lc_read(m,a,&before,4))return 0;
+ return before==v || dry || m.write(m.ctx,a,&v,4);
+}
+static inline int lc_fill(LCMemory m,uint64_t obj,int dry,uint32_t limit) {
+ uint64_t max=lc_ptr(m,obj,0x1838),cur=lc_ptr(m,obj,0x1830);uint32_t n=0,old=0;
+ if(!max||!cur||!lc_read(m,max+8,&n,4)||!lc_read(m,cur+8,&old,4)||!n||n>limit||old>n)return 0;
+ return lc_put(m,cur+8,n,dry);
+}
+static inline LCStats lc_tick(LCMemory m, uint64_t base, unsigned flags, int dry) {
+ LCStats s={0};if(!flags||base>UINT64_MAX-0x4721b98)return s;
+ const uint32_t actor_path[]={0x46af308,0x480,0x228};
+ uint64_t actor=lc_chain(m,base,actor_path,3);
+ if(flags&1){
+  uint64_t health=lc_ptr(m,actor,0x2f8);
+  if(lc_fill(m,health,dry,160)){
+   s.ready|=1;s.writes[0]++;
+   uint64_t gloom=lc_ptr(m,health,0x1848);uint32_t v=0;
+   if(gloom&&lc_read(m,gloom+8,&v,4)&&v<=160)lc_put(m,gloom+8,0,dry);
+  }
+ }
+ uint64_t data=lc_ptr(m,base,0x4721b98);
+ if(flags&2){
+  uint64_t cap=lc_ptr(m,data,0x198),cur=lc_ptr(m,actor,0x3a8);float n=0,v=0;
+  if(cap&&cur&&lc_read(m,cap+0x5bc,&n,4)&&lc_read(m,cur+0x13fc,&v,4)&&n>0&&n<=10000&&v>=0&&v<=n){
+   uint32_t bits;memcpy(&bits,&n,4);if(lc_put(m,cur+0x13fc,bits,dry)){s.ready|=2;s.writes[1]++;}
+  }
+ }
+ if(flags&4){
+  const uint32_t weapon_path[]={0x230,0x28,0x40,0x228,0x2f8};
+  uint64_t weapon=lc_chain(m,actor,weapon_path,5);
+  if(lc_fill(m,weapon,dry,100000)){s.ready|=4;s.writes[2]++;}
+ }
+ if(flags&8){
+  uint64_t wallet=lc_ptr(m,data,0xd8);uint32_t old;
+  if(wallet&&lc_read(m,wallet+0x28ea4,&old,4)&&old<=999999&&lc_put(m,wallet+0x28ea4,999998,dry)){s.ready|=8;s.writes[3]++;}
+ }
+ if(flags&16){
+  const uint32_t inventory_path[]={0x138,0xf28};uint64_t p=lc_chain(m,data,inventory_path,2);
+  /* Source 640F1000 advances four on the non-sentinel arm.
+   * 21000000 begins ELSE: 780F0000 advances eight only for sentinel slots. */
+  for(unsigned i=0;i<255&&p;i++){
+   uint32_t qty;if(!lc_read(m,p,&qty,4))break;
+   if(qty!=UINT32_MAX){
+    if(qty>999)break; /* invalid layout: never walk further into unknown objects */
+    if(qty&&lc_put(m,p,888,dry)){s.ready|=16;s.writes[4]++;}
+    if(p>UINT64_MAX-4)break;p+=4;
+   } else {
+    if(p>UINT64_MAX-8)break;p+=8;
+   }
+  }
+ }
+ return s;
+}
+#endif
diff --git a/games/totk/runtime/local_cheats121_config.h b/games/totk/runtime/local_cheats121_config.h
new file mode 100644
index 0000000..0dae48d
--- /dev/null
+++ b/games/totk/runtime/local_cheats121_config.h
@@ -0,0 +1,30 @@
+#ifndef LOCAL_CHEATS121_CONFIG_H
+#define LOCAL_CHEATS121_CONFIG_H
+#include <stdio.h>
+#include <string.h>
+#include <ctype.h>
+typedef struct { unsigned flags; int dry; int valid; } LCConfig;
+/* Missing, duplicate or malformed settings fail closed. No arbitrary addresses or values. */
+static inline LCConfig lc_config(FILE *f) {
+ LCConfig c={0,1,0};if(!f)return c;
+ const char *names[]={"enabled","health","stamina","weapon","rupees","materials","dry_run"};
+ unsigned seen=0,enabled=0;char line[256];
+ while(fgets(line,sizeof line,f)){
+  if(!strchr(line,'\n')&&!feof(f))return (LCConfig){0,1,0};
+  char *comment=strchr(line,'#');if(comment)*comment=0;
+  char *p=line;while(isspace((unsigned char)*p))p++;if(!*p)continue;
+  char *eq=strchr(p,'=');if(!eq)return (LCConfig){0,1,0};*eq=0;
+  char *end=eq;while(end>p&&isspace((unsigned char)end[-1]))*--end=0;
+  char *v=eq+1;while(isspace((unsigned char)*v))v++;
+  if(*v!='0'&&*v!='1')return (LCConfig){0,1,0};int bit=*v++-'0';
+  while(isspace((unsigned char)*v))v++;if(*v)return (LCConfig){0,1,0};
+  unsigned i;for(i=0;i<7&&strcmp(p,names[i]);i++);
+  if(i==7||(seen&(1u<<i)))return (LCConfig){0,1,0};seen|=1u<<i;
+  if(i==0)enabled=(unsigned)bit;else if(i==6)c.dry=bit;else if(bit)c.flags|=1u<<(i-1);
+ }
+ if(ferror(f))return (LCConfig){0,1,0};c.valid=1;if(!enabled)c.flags=0;return c;
+}
+static inline int lc_identity(const char *version,const char *digest){
+ return version&&digest&&!strcmp(version,"1.2.1")&&!strcmp(digest,"b7a2cc7e3465c4f11cd23f34cb38e037cf51d1d18310206f03b86c160ff2dbd0");
+}
+#endif
diff --git a/games/totk/runtime/local_cheats121_host.h b/games/totk/runtime/local_cheats121_host.h
new file mode 100644
index 0000000..7319e3a
--- /dev/null
+++ b/games/totk/runtime/local_cheats121_host.h
@@ -0,0 +1,60 @@
+#ifndef LOCAL_CHEATS121_HOST_H
+#define LOCAL_CHEATS121_HOST_H
+#include "local_cheats121.h"
+#include "local_cheats121_config.h"
+#include <mach/mach.h>
+#include <mach/mach_vm.h>
+#include <pthread.h>
+#include <unistd.h>
+#include <stdlib.h>
+#include <errno.h>
+/* Validating the mapping cannot prevent a concurrent game object from changing.
+ * This adapter is for a separate experimental profile, never a general memory editor. */
+static inline int lc_mapping(uint64_t addr,size_t n,int writing){
+ if(addr<0x1000||n>0x8000000000ULL||addr>0x8000000000ULL-n)return 0;
+ mach_vm_address_t at=addr;mach_vm_size_t size=0;mach_port_t object=MACH_PORT_NULL;
+ vm_region_basic_info_data_64_t info;mach_msg_type_number_t count=VM_REGION_BASIC_INFO_COUNT_64;
+ kern_return_t kr=mach_vm_region(mach_task_self(),&at,&size,VM_REGION_BASIC_INFO_64,(vm_region_info_t)&info,&count,&object);
+ if(object!=MACH_PORT_NULL)mach_port_deallocate(mach_task_self(),object);
+ if(kr!=KERN_SUCCESS||at>addr||addr-at>size||n>size-(addr-at))return 0;
+ if(!(info.protection&VM_PROT_READ))return 0;
+ return !writing||((info.protection&VM_PROT_WRITE)&&!(info.protection&VM_PROT_EXECUTE));
+}
+typedef struct { uint64_t writes,base,size; int (*guest)(uint64_t,size_t); } LCScope;
+static inline int lc_owned(LCScope *s,uint64_t a,size_t n,int writing){
+ if(!s)return 0;
+ if(!writing&&a>=s->base&&n<=s->size&&a-s->base<=s->size-n)return 1;
+ return s->guest&&s->guest(a,n);
+}
+static inline int lc_mach_read(void *ctx,uint64_t addr,void *out,size_t n){
+ if(!lc_owned(ctx,addr,n,0)||!lc_mapping(addr,n,0))return 0;mach_vm_size_t got=0;
+ return mach_vm_read_overwrite(mach_task_self(),addr,n,(mach_vm_address_t)out,&got)==KERN_SUCCESS&&got==n;
+}
+static inline int lc_mach_write(void *ctx,uint64_t addr,const void *in,size_t n){
+ if(n!=4||!lc_owned(ctx,addr,n,1)||!lc_mapping(addr,n,1))return 0;
+ kern_return_t kr=mach_vm_write(mach_task_self(),addr,(vm_offset_t)in,(mach_msg_type_number_t)n);
+ if(kr==KERN_SUCCESS&&ctx)((LCScope *)ctx)->writes++;
+ return kr==KERN_SUCCESS;
+}
+typedef struct { LCScope scope; const char *config; } LCHost;
+static void *lc_worker(void *arg){
+ LCHost *h=arg;unsigned tick=0,previous=UINT32_MAX;int last_dry=-1;
+ LCMemory m={&h->scope,lc_mach_read,lc_mach_write};
+ for(;;){
+  FILE *f=fopen(h->config,"r");LCConfig cfg=lc_config(f);if(f)fclose(f);
+  if(previous!=cfg.flags||last_dry!=cfg.dry){fprintf(stderr,"[local-cheats121] config valid=%d enabled-mask=%u dry-run=%d\n",cfg.valid,cfg.flags,cfg.dry);previous=cfg.flags;last_dry=cfg.dry;}
+  LCStats s=lc_tick(m,h->scope.base,cfg.flags,cfg.dry);
+  if(cfg.flags&&tick%50==0)fprintf(stderr,"[local-cheats121] ready-mask=%u valid-targets=%u,%u,%u,%u,%u actual-writes=%llu\n",s.ready,s.writes[0],s.writes[1],s.writes[2],s.writes[3],s.writes[4],(unsigned long long)h->scope.writes);
+  tick++;usleep(100000);
+ }
+ return NULL;
+}
+static inline void lc_host_start(uint64_t base,uint64_t size,int (*guest)(uint64_t,size_t),const char *version,const char *digest){
+ const char *path=getenv("TOTK_LOCAL_CHEATS");if(!path||!*path)return;
+ if(!lc_identity(version,digest)){fprintf(stderr,"[local-cheats121] refused: version or module identity mismatch\n");return;}
+ static LCHost h;h.scope=(LCScope){0,base,size,guest};h.config=strdup(path);if(!h.config)return;
+ pthread_t worker;int err=pthread_create(&worker,NULL,lc_worker,&h);
+ if(err){fprintf(stderr,"[local-cheats121] thread unavailable (%d)\n",err);free((void *)h.config);return;}
+ pthread_detach(worker);fprintf(stderr,"[local-cheats121] experimental self-memory probe; matching 1.2.1 module\n");
+}
+#endif
