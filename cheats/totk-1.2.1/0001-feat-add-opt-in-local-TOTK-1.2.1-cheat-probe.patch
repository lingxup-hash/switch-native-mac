+"""Behavioral fixture and macOS mapping checks for opt-in local 1.2.1 cheats."""
+import pathlib
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+
+@unittest.skipUnless(shutil.which('xcrun'), 'requires macOS compiler and Mach APIs')
+class LocalCheatProbes(unittest.TestCase):
+    def test_memory_effects_config_and_real_mapping_guards(self):
+        for name in ('local_cheats121_probe', 'local_cheats121_config_probe', 'local_cheats121_host_probe'):
+            with self.subTest(probe=name), tempfile.TemporaryDirectory() as temp:
+                executable = pathlib.Path(temp) / name
+                build = subprocess.run(['xcrun', 'clang', '-std=c11', '-Wall', '-Wextra', '-Werror',
+                                        str(ROOT / 'tests' / (name + '.c')), '-o', str(executable)],
+                                       text=True, capture_output=True)
+                self.assertEqual(build.returncode, 0, build.stderr)
+                run = subprocess.run([str(executable)], text=True, capture_output=True)
+                self.assertEqual(run.returncode, 0, run.stderr)
+                self.assertIn('PASS', run.stdout)
