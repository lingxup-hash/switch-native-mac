+/* Synthetic address-space fixture: literal expected values independent of cheat implementation. */
+#include <assert.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include "../games/totk/runtime/local_cheats121.h"
+#define SIZE 0x4804000
+static unsigned char *data;
+static uint64_t denied;
+static int read_mem(void *c,uint64_t a,void *p,size_t n){(void)c;if(a<0x1000||a>SIZE||n>SIZE-a||a==denied)return 0;memcpy(p,data+a,n);return 1;}
+static int write_mem(void *c,uint64_t a,const void *p,size_t n){(void)c;if(a<0x1000||a>SIZE||n>SIZE-a||a==denied)return 0;memcpy(data+a,p,n);return 1;}
+static void q(uint64_t a,uint64_t v){memcpy(data+a,&v,8);}
+static void w(uint64_t a,uint32_t v){memcpy(data+a,&v,4);}
+static uint32_t r(uint64_t a){uint32_t v;memcpy(&v,data+a,4);return v;}
+static void fixture(void){
+ memset(data,0,SIZE);denied=0;
+ q(0x1000+0x46af308,0x10000);q(0x10480,0x11000);q(0x11228,0x12000);q(0x122f8,0x14000);
+ q(0x15838,0x16000);q(0x15830,0x17000);q(0x15848,0x18000);w(0x16008,12);w(0x17008,4);w(0x18008,4);
+ q(0x1000+0x4721b98,0x19000);q(0x19198,0x1a000);w(0x1a5bc,0x447a0000);q(0x123a8,0x1b000);w(0x1c3fc,0x43fa0000);
+ q(0x12230,0x20000);q(0x20028,0x21000);q(0x21040,0x22000);q(0x22228,0x23000);q(0x232f8,0x24000);
+ q(0x25838,0x26000);q(0x25830,0x27000);w(0x26008,30);w(0x27008,11);
+ q(0x190d8,0x28000);w(0x50ea4,25);
+ q(0x19138,0x52000);q(0x52f28,0x54000);
+ /* Original VM: successful 640F1000 advances 4; ELSE advances 8 only for the sentinel. */
+ memset(data+0x54000,0xff,0x1000);w(0x54000,12);w(0x54004,7);w(0x5400c,0x5678);w(0x54010,3);w(0x54018,0x8765);
+}
+int main(void){
+ data=calloc(1,SIZE);assert(data);LCMemory m={0,read_mem,write_mem};fixture();
+ LCStats s=lc_tick(m,0x1000,0,0);assert(!s.ready&&r(0x17008)==4);
+ s=lc_tick(m,0x1000,31,1);assert(r(0x17008)==4&&r(0x50ea4)==25);
+ s=lc_tick(m,0x1000,1,0);assert(r(0x17008)==12);assert(r(0x18008)==0);assert(r(0x27008)==11);
+ s=lc_tick(m,0x1000,2,0);assert(r(0x1c3fc)==0x447a0000);
+ s=lc_tick(m,0x1000,4,0);assert(r(0x27008)==30);
+ s=lc_tick(m,0x1000,8,0);assert(r(0x50ea4)==999998);
+ s=lc_tick(m,0x1000,16,0);assert(r(0x54000)==888&&r(0x54010)==888&&r(0x54004)==888);assert(r(0x54008)==0xffffffff);assert(r(0x5400c)==0x5678&&r(0x54018)==0x8765);
+ fixture();q(0x11228,0);lc_tick(m,0x1000,7,0);assert(r(0x17008)==4&&r(0x27008)==11);
+ fixture();denied=0x17008;lc_tick(m,0x1000,1,0);assert(r(0x17008)==4);
+ fixture();w(0x16008,0x7fffffff);lc_tick(m,0x1000,1,0);assert(r(0x17008)==4);
+ fixture();w(0x54000,0);lc_tick(m,0x1000,16,0);assert(r(0x54000)==0&&r(0x54010)==888&&r(0x54004)==888);
+ fixture();lc_tick(m,UINT64_MAX-3,31,0);assert(r(0x17008)==4);
+ free(data);puts("local cheat fixture PASS");
+}
